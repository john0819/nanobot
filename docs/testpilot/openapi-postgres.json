  "components": {
    "securitySchemes": {
      "LocalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "TaskRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "healthy",
            "enum": [
              "healthy",
              "retry-write-bug"
            ],
            "title": "Mode",
            "type": "string"
          },
          "goal": {
            "default": "Validate gateway fixture",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "require_approval": {
            "default": false,
            "title": "Require Approval",
            "type": "boolean"
          },
          "require_knowledge": {
            "default": false,
            "title": "Require Knowledge",
            "type": "boolean"
          }
        },
        "title": "TaskRequest",
        "type": "object"
      },
      "ApprovalDecision": {
        "additionalProperties": false,
        "properties": {
          "request_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Hash",
            "type": "string"
          },
          "decision": {
            "enum": [
              "APPROVE",
              "DENY"
            ],
            "title": "Decision",
            "type": "string"
          }
        },
        "required": [
          "request_hash",
          "decision"
        ],
        "title": "ApprovalDecision",
        "type": "object"
      },
      "RerunRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_state_version": {
            "minimum": 0,
            "title": "Expected State Version",
            "type": "integer"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "expected_state_version",
          "reason"
        ],
        "title": "RerunRequest",
        "type": "object"
      },
      "MemoryCandidateRequest": {
        "additionalProperties": false,
        "properties": {
          "source_run_id": {
            "pattern": "^run_[0-9a-f]{32}$",
            "title": "Source Run Id",
            "type": "string"
          },
          "case_id": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Case Id",
            "type": "string"
          },
          "shared": {
            "default": false,
            "title": "Shared",
            "type": "boolean"
          }
        },
        "required": [
          "source_run_id",
          "case_id"
        ],
        "title": "MemoryCandidateRequest",
        "type": "object"
      },
      "MemoryDecision": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1,
            "title": "Expected Version",
            "type": "integer"
          },
          "decision": {
            "pattern": "^(CONFIRM|REVOKE)$",
            "title": "Decision",
            "type": "string"
          }
        },
        "required": [
          "expected_version",
          "decision"
        ],
        "title": "MemoryDecision",
        "type": "object"
      },
      "StateControl": {
        "additionalProperties": false,
        "properties": {
          "expected_state_version": {
            "minimum": 0,
            "title": "Expected State Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_state_version"
        ],
        "title": "StateControl",
        "type": "object"
      },
      "TaskInput": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Client Request Id",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "client_request_id",
          "text"
        ],
        "title": "TaskInput",
        "type": "object"
      },
      "TaskSnapshot": {
        "type": "object",
        "required": [
          "task_id",
          "state",
          "mode",
          "created_at",
          "error",
          "report_ready",
          "operation_id",
          "run_id",
          "lease_epoch",
          "model_rounds"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "lease_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "state_version": {
            "type": "integer",
            "minimum": 0
          },
          "model_limit": {
            "type": "integer",
            "minimum": 4,
            "maximum": 40
          },
          "model_rounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "waiting_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_wakeup_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "task_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "QUEUED",
              "WAITING_APPROVAL",
              "RUNNING",
              "WAITING_EXTERNAL",
              "RECONCILING",
              "PAUSED",
              "CANCELLING",
              "COMPLETED",
              "NEEDS_REVIEW",
              "CANCELLED"
            ]
          },
          "mode": {
            "enum": [
              "healthy",
              "retry-write-bug"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_ready": {
            "type": "boolean"
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
