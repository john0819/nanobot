{
  "openapi": "3.1.0",
  "info": {
    "title": "TestPilot local Task API",
    "version": "0.2.0",
    "description": "Loopback development only. In-memory task state; no durable recovery."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8920"
    }
  ],
  "security": [
    {
      "LocalBearer": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process healthy"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI contract"
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks": {
      "post": {
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Admitted asynchronous task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}": {
      "get": {
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped task snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/report": {
      "get": {
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validated or safe NEEDS_REVIEW report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "task_id",
                    "report_validated",
                    "quality_verdict",
                    "validation_gaps"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/cancel": {
      "post": {
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancellation resolved or terminal state unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/artifacts/{hash}": {
      "get": {
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Integrity checked scoped artifact",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "TaskRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "healthy",
            "enum": [
              "healthy",
              "retry-write-bug"
            ],
            "title": "Mode",
            "type": "string"
          },
          "goal": {
            "default": "Validate gateway fixture",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "require_approval": {
            "default": false,
            "title": "Require Approval",
            "type": "boolean"
          },
          "require_knowledge": {
            "default": false,
            "title": "Require Knowledge",
            "type": "boolean"
          }
        },
        "title": "TaskRequest",
        "type": "object"
      },
      "TaskSnapshot": {
        "type": "object",
        "required": [
          "task_id",
          "state",
          "mode",
          "created_at",
          "error",
          "report_ready",
          "operation_id"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "QUEUED",
              "WAITING_APPROVAL",
              "RUNNING",
              "WAITING_EXTERNAL",
              "RECONCILING",
              "CANCELLING",
              "COMPLETED",
              "NEEDS_REVIEW",
              "CANCELLED"
            ]
          },
          "mode": {
            "enum": [
              "healthy",
              "retry-write-bug"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_ready": {
            "type": "boolean"
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
